{
  "name": "infweb",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "鲲版无限网页角色卡：纯前端角色卡 + 规则书 + 更新记录（Vue 3 + Vite）。",
  "scripts": {
    "build": "gulp build",
    "prettier": "prettier --write ./**/*.{js,json,md,mjs,yml}",
    "test": "mocha",
    "dev": "vite",
    "build:vite": "vite build",
    "preview": "vite preview",
    "test:logic": "vitest run"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "archiver": "^7.0.1",
    "del": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-recommended": "^4.1.0",
    "eslint-plugin-mocha": "^10.4.1",
    "glob": "^10.3.12",
    "gulp": "^5.0.0",
    "gulp-autoprefixer": "^9.0.0",
    "gulp-eslint": "^6.0.0",
    "gulp-header": "^2.0.9",
    "gulp-rename": "^2.0.0",
    "main.css": "3.0.0",
    "mocha": "^10.4.0",
    "prettier": "3.2.5",
    "strip-json-comments": "^5.0.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "h5bp-configs": {
    "directories": {
      "archive": "archive",
      "dist": "dist",
      "src": "src",
      "test": "test"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE.txt",
    "package.json",
    "dist/",
    "README.md"
  ]
}
